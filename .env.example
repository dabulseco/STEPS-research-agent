# Copy this file to .env and fill in your own values.
# .env is git-ignored — your key will never be committed.

# Optional: enables Ollama Cloud models in the sidebar's model picker, and
# Ollama Web Search (the default web search method; falls back to
# DuckDuckGo/Selenium if unavailable).
# Get a key at https://ollama.com/settings/keys (requires an Ollama account).
# Cloud models are billed per token from your Ollama account's usage credits.
OLLAMA_API_KEY=

# Optional: override the Ollama Cloud API base URL (rarely needed).
# OLLAMA_CLOUD_BASE_URL=https://ollama.com
